<?xml version="1.0" encoding="utf-8"?>
<!-- 密码列表页（照抄模板 43 NeumorphismVault）：brand-mark 凸起锁徽标 + 标题/caption + 设置圆钮（avatar 位）+
     凹陷胶囊搜索（放大镜）+ 分类 chip（凸起 XS/选中凹陷）+ 条目卡（r26 SM）+ 悬浮 FAB 58dp + 凹陷圆底空状态。
     NeuSurface wrap_content：内部 child 给尺寸，halo 由父 clipChildren=false 保留。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingLeft="20dp" android:paddingRight="20dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 顶栏（模板 .topbar）：brand-mark 46dp r18 凸起 SM + 锁 22dp primary + 标题 19sp / sub 11sp + avatar 44dp -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:clipChildren="false" android:clipToPadding="false">

            <!-- .brand-mark：46dp r-md 18，凸起 SM，锁 svg 22dp primary -->
            <com.qiqiao.passwordvault.ui.common.NeuSurface
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:neuDirection="raised"
                app:neuElevation="sm"
                app:neuCornerRadius="@dimen/radius_secret">

                <ImageView
                    android:layout_width="46dp" android:layout_height="46dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_lock_24"
                    android:scaleType="fitCenter"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />
            </com.qiqiao.passwordvault.ui.common.NeuSurface>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/list_brand_title"
                    android:textSize="19sp" android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/on_surface" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/list_brand_caption"
                    android:textSize="11sp" android:letterSpacing="0.08"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <!-- .avatar（模板）：凸起圆 44dp，点击换头像；有图显示图片（圆形裁剪），无图显示 17° 文字 -->
            <com.qiqiao.passwordvault.ui.common.NeuSurface
                android:id="@+id/avatarContainer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:neuShape="circle"
                app:neuDirection="raised"
                app:neuElevation="sm">

                <FrameLayout
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_clip"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/avatarText"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/list_brand_avatar"
                        android:textSize="15sp" android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <ImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </com.qiqiao.passwordvault.ui.common.NeuSurface>
        </LinearLayout>

        <!-- 搜索（模板 .search）：凹陷（radius_soft 16dp，内阴影圆角 10-16 最自然），padding 13x18，放大镜 17dp，字 14sp -->
        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:neuDirection="inset"
            app:neuCornerRadius="@dimen/radius_soft">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="18dp" android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="17dp" android:layout_height="17dp"
                    android:src="@drawable/ic_search_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginStart="10dp"
                    android:hint="@string/list_search_hint"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:textColor="?attr/pwdTextIn"
                    android:textColorHint="@color/on_surface_variant" />

                <!-- 排序入口（审查 2.2）：后端支持 4 种排序但此前无入口，硬编码 NAME_ASC。
                     复用已有 ic_sort_24，与分类管理页排序按钮对称，不改视觉风格。 -->
                <ImageButton
                    android:id="@+id/btnSort"
                    android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_sort_24"
                    app:tint="@color/on_surface_variant"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/list_sort" />
            </LinearLayout>
        </com.qiqiao.passwordvault.ui.common.NeuSurface>

        <!-- 分类筛选 chips（模板 .chip：凸起 XS，选中凹陷 + primary） -->
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp" android:paddingBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </HorizontalScrollView>

        <!-- 结果计数（审查 2.4）：搜索/选分类后告知"共 N 条"，避免"没搜到"与"库为空"混淆 -->
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="0dp" android:layout_marginBottom="4dp"
            android:paddingStart="4dp"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false" android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvList"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingTop="2dp" android:paddingBottom="88dp" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone" />

            <!-- 空状态（模板 .empty）：凹陷圆底图标 42dp + 文案 13sp -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical" android:gravity="center"
                android:visibility="gone">

                <com.qiqiao.passwordvault.ui.common.NeuSurface
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:neuShape="circle"
                    app:neuDirection="inset">

                    <ImageView
                        android:layout_width="72dp" android:layout_height="72dp"
                        android:src="@drawable/ic_lock_24"
                        android:scaleType="center"
                        app:tint="@color/on_surface_variant"
                        android:alpha="0.6"
                        android:importantForAccessibility="no" />
                </com.qiqiao.passwordvault.ui.common.NeuSurface>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:text="@string/list_empty" android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone"
                android:text="@string/list_error" android:textColor="@color/error"
                android:clickable="true" android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- 底部导航（模板 .tabbar）：凸起 r26 圆角长条 LG 阴影，三栏 = 主页 / 新增 / 设置 -->
    <com.qiqiao.passwordvault.ui.common.NeuSurface
        android:id="@+id/tabbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="4dp" android:layout_marginRight="4dp"
        android:layout_marginBottom="8dp"
        app:neuDirection="raised"
        app:neuElevation="lg"
        app:neuCornerRadius="@dimen/radius_card"
        android:clipChildren="false" android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="10dp" android:paddingBottom="10dp">

            <!-- 主页（当前页，primary 高亮） -->
            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_home_24"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_home"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <!-- 数据（2026-09-06 用户需求：数据管理独立页） -->
            <LinearLayout
                android:id="@+id/btnNavData"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_data_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_data"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <!-- 新增（+号） -->
            <LinearLayout
                android:id="@+id/btnNavAdd"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/list_add"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <!-- 设置 -->
            <LinearLayout
                android:id="@+id/btnNavSettings"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_settings_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/list_settings"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </com.qiqiao.passwordvault.ui.common.NeuSurface>
</FrameLayout>