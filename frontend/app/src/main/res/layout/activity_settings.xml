                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_home_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_home"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavData"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_data_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_data"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavAdd"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/on_surface_variant"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/list_add"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavSettings"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_settings_24"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/list_settings"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </com.qiqiao.passwordvault.ui.common.NeuSurface>
</LinearLayout>