<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PasswordVault">
        <activity
            android:name=".ui.unlock.UnlockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.list.PasswordListActivity" android:exported="false" />
        <activity android:name=".ui.detail.EntryDetailActivity" android:exported="false" />
        <!-- adjustResize（2026-09-06 修复）：默认 pan 会让键盘把整窗顶出屏幕、顶部保存按钮"消失" -->
        <activity android:name=".ui.edit.EntryEditActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.generator.PasswordGeneratorActivity" android:exported="false" />
        <activity android:name=".ui.category.CategoryManageActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.export.ExportBackupActivity" android:exported="false" />
        <activity android:name=".ui.export.ExportDoneActivity" android:exported="false" />
        <activity android:name=".ui.import.ImportBackupActivity" android:exported="false" />
        <activity android:name=".ui.import.BatchImportActivity" android:exported="false" />
        <activity android:name=".ui.import.DataManageActivity" android:exported="false" />
    </application>

</manifest>
