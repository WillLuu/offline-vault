<?xml version="1.0" encoding="utf-8"?>
<!-- 分类管理页（新拟态真高斯模糊版）：顶栏 = 返回圆按钮 + 标题 + 新增按钮（NeuSurface 容器） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground"
    android:clipChildren="false" android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="@dimen/space_md" android:paddingRight="@dimen/space_md"
        android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_sm"
        android:clipChildren="false" android:clipToPadding="false">

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:neuShape="circle"
            app:neuDirection="raised"
            app:neuElevation="sm">

            <ImageButton android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back_24" android:contentDescription="@string/common_cancel" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="@dimen/space_sm"
            android:text="@string/category_title" android:textSize="@dimen/text_large"
            android:textStyle="bold" android:textColor="@color/on_surface" />

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:neuDirection="raised"
            app:neuElevation="xs"
            app:neuCornerRadius="@dimen/radius_field">

            <ImageButton android:id="@+id/btnSort"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_sort_24"
                android:contentDescription="@string/category_sort" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="12dp"
            app:neuDirection="raised"
            app:neuElevation="xs"
            app:neuCornerRadius="@dimen/radius_field">

            <Button android:id="@+id/btnAdd"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="@string/category_add" android:textAllCaps="false"
                android:textColor="@color/on_surface" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategory"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false"
        android:padding="@dimen/space_md" android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:gravity="center"
        android:text="@string/list_empty" android:textColor="@color/on_surface_variant"
        android:layout_margin="@dimen/space_lg" />
</LinearLayout>