<?xml version="1.0" encoding="utf-8"?>
<!-- 导出备份页（新拟态真高斯模糊版）：顶栏 + 主卡 + 两个密码输入 + 底部主按钮全用 NeuSurface -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground"
    android:clipChildren="false" android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="@dimen/space_md" android:paddingRight="@dimen/space_md"
        android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_sm"
        android:clipChildren="false" android:clipToPadding="false">

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:neuShape="circle"
            app:neuDirection="raised"
            app:neuElevation="sm">

            <ImageButton android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back_24" android:contentDescription="@string/common_cancel" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="@dimen/space_sm"
            android:text="@string/export_title" android:textSize="@dimen/text_large"
            android:textStyle="bold" android:textColor="@color/on_surface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="@dimen/space_md"
        android:clipChildren="false" android:clipToPadding="false">

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:neuDirection="raised"
            app:neuElevation="sm"
            app:neuCornerRadius="@dimen/radius_card">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:clipChildren="false" android:clipToPadding="false">

                <RadioGroup android:id="@+id/rgMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12">
                    <RadioButton android:id="@+id/rbMaster" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/export_use_master" android:checked="true" android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbIndependent" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/export_use_independent" android:textColor="@color/on_surface" />
                </RadioGroup>

                <TextView android:id="@+id/lblPw" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/export_password" android:labelFor="@id/etPassword" android:textColor="@color/on_surface_variant" android:textSize="13sp" />
                <com.qiqiao.passwordvault.ui.common.NeuSurface
                    android:id="@+id/neuPw"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:layout_marginBottom="@dimen/space_sm"
                    app:neuDirection="inset" app:neuElevation="xs"
                    app:neuCornerRadius="@dimen/radius_field">

                    <EditText android:id="@+id/etPassword"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="@android:color/transparent"
                        android:padding="12dp"
                        android:inputType="textPassword" android:importantForAutofill="no" android:textColor="@color/on_surface" />
                </com.qiqiao.passwordvault.ui.common.NeuSurface>

                <TextView android:id="@+id/lblConfirm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/export_confirm_pw" android:labelFor="@id/etConfirm" android:textColor="@color/on_surface_variant" />
                <com.qiqiao.passwordvault.ui.common.NeuSurface
                    android:id="@+id/neuConfirm"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:neuDirection="inset" app:neuElevation="xs"
                    app:neuCornerRadius="@dimen/radius_field">

                    <EditText android:id="@+id/etConfirm"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="@android:color/transparent"
                        android:padding="12dp"
                        android:inputType="textPassword" android:importantForAutofill="no" android:textColor="@color/on_surface" />
                </com.qiqiao.passwordvault.ui.common.NeuSurface>
            </LinearLayout>
        </com.qiqiao.passwordvault.ui.common.NeuSurface>
    </ScrollView>

    <!-- 底部主按钮：NeuSurface RAISED LG 胶囊 wrap_content + 内 52dp Button -->
    <com.qiqiao.passwordvault.ui.common.NeuSurface
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md" android:layout_marginRight="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        app:neuDirection="raised"
        app:neuElevation="lg"
        app:neuCornerRadius="@dimen/radius_pill">

        <Button android:id="@+id/btnConfirm"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:textColor="?attr/colorOnPrimary" android:textSize="16sp"
            android:text="@string/export_confirm" android:textAllCaps="false" />
    </com.qiqiao.passwordvault.ui.common.NeuSurface>
</LinearLayout>