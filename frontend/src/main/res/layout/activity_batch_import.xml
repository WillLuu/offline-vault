<?xml version="1.0" encoding="utf-8"?>
<!-- 批量录入页：粘贴笔记 → 解析 → 预览修正 → 写入 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/space_md"
        android:paddingRight="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:neuShape="circle"
            app:neuDirection="raised"
            app:neuElevation="sm">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back_24"
                android:contentDescription="@string/common_cancel" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/batch_title"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"
            android:textColor="@color/on_surface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="@dimen/space_md"
        android:paddingRight="@dimen/space_md"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_md"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/batch_hint_top"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.qiqiao.passwordvault.ui.common.NeuSurface
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:neuDirection="inset"
                app:neuElevation="xs"
                app:neuCornerRadius="@dimen/radius_field">

                <EditText
                    android:id="@+id/etPaste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="160dp"
                    android:gravity="top"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:hint="@string/batch_paste_hint"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:inputType="textMultiLine" />
            </com.qiqiao.passwordvault.ui.common.NeuSurface>

            <com.qiqiao.passwordvault.ui.common.NeuSurface
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:neuDirection="raised"
                app:neuElevation="xs"
                app:neuCornerRadius="@dimen/radius_field">

                <Button
                    android:id="@+id/btnParse"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:text="@string/batch_parse"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary" />
            </com.qiqiao.passwordvault.ui.common.NeuSurface>

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.qiqiao.passwordvault.ui.common.NeuSurface
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:neuDirection="raised"
            app:neuElevation="xs"
            app:neuCornerRadius="@dimen/radius_field">

            <Button
                android:id="@+id/btnImport"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:text="@string/batch_import_idle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:enabled="false" />
        </com.qiqiao.passwordvault.ui.common.NeuSurface>
    </LinearLayout>
</LinearLayout>
